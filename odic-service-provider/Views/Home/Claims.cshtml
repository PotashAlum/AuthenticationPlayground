@model IEnumerable<System.Security.Claims.Claim>
@{
    ViewBag.Title = "Claims";
}

<div class="card">
    <h2>User Claims</h2>
    <p style="margin: 12px 0;">These are the claims received from Microsoft Entra ID after authentication.</p>
    <table>
        <thead>
            <tr>
                <th>Claim Type</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.Type</td>
                    <td>@claim.Value</td>
                </tr>
            }
        </tbody>
    </table>
    <div style="margin-top: 16px;">
        <a href="@Url.Action("Index", "Home")" class="btn">Back to Home</a>
    </div>
</div>
