<?xml version="1.0" encoding="utf-8"?>
<!-- Copy this file to secrets.config and fill in your actual values -->
<appSettings>
  <!-- Azure AD Tenant ID -->
  <add key="AzureTenantId" value="YOUR_TENANT_ID_HERE" />

  <!-- Browser Extension ID (Chrome/Edge) -->
  <add key="ExtensionId" value="YOUR_EXTENSION_ID_HERE" />

  <!-- SAML Entity ID -->
  <add key="SamlEntityId" value="https://localhost:44300/" />

  <!-- Auth App URL -->
  <add key="AuthAppUrl" value="https://localhost:44300" />

  <!-- OIDC/OpenID Connect Settings (for oidc-service-provider) -->
  <add key="ida:ClientId" value="YOUR_OIDC_CLIENT_ID" />
  <add key="ida:ClientSecret" value="YOUR_OIDC_CLIENT_SECRET" />
  <add key="ida:TenantId" value="YOUR_TENANT_ID_HERE" />
</appSettings>
