<Window x:Class="DummyDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dummy Desktop Application" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Dummy Desktop Application" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Centralized Authentication Demo" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#E7F3FF" Padding="15" CornerRadius="4" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Checking authentication status..." FontWeight="SemiBold"/>
                <ProgressBar x:Name="LoadingBar" Height="4" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#F8F9FA" Padding="15" CornerRadius="4" Margin="0,0,0,20">
            <ScrollViewer>
                <StackPanel x:Name="UserInfoPanel" Visibility="Collapsed">
                    <TextBlock Text="User Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel>
                        <TextBlock Margin="0,5,0,0">
                            <Run Text="Name: " FontWeight="Bold"/>
                            <Run x:Name="UserNameText" Text=""/>
                        </TextBlock>
                        <TextBlock Margin="0,5,0,0">
                            <Run Text="Email: " FontWeight="Bold"/>
                            <Run x:Name="UserEmailText" Text=""/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="LoginButton" Content="Login" Width="100" Height="35" Margin="5"
                    Click="LoginButton_Click" Visibility="Collapsed"/>
            <Button x:Name="CheckExtensionButton" Content="Check Extension" Width="120" Height="35" Margin="5"
                    Click="CheckExtensionButton_Click"/>
            <Button x:Name="LogoutButton" Content="Logout" Width="100" Height="35" Margin="5"
                    Click="LogoutButton_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
