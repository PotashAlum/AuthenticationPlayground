# SAML Service Provider Configuration

# Server Configuration
PORT=3000

# ===== OPTION 1: Use IdP Metadata URL (Recommended) =====
# If you provide a metadata URL, the IdP settings below will be automatically populated
SAML_METADATA_URL=https://login.microsoftonline.com/00c28018-c233-4297-87e0-102766efad56/federationmetadata/2007-06/federationmetadata.xml?appid=392e0c42-2ef3-45d6-8561-4eb70f3e187a

# ===== OPTION 2: Manual IdP Configuration =====
# If not using metadata URL, configure these manually:
# SAML_ENTRY_POINT=https://idp.example.com/sso
# SAML_LOGOUT_URL=https://idp.example.com/logout
# SAML_IDP_CERT=<base64-encoded-certificate>

# ===== Service Provider (SP) Settings =====
# IMPORTANT: SAML_ISSUER must match the "Entity ID" or "Identifier" configured in your IdP
# For Azure AD, this is set in the Enterprise Application's SAML configuration
SAML_ISSUER=saml-service-provider
SAML_CALLBACK_URL=http://localhost:3000/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3000/logout/callback

# ===== Optional: Audience Validation =====
# By default, uses SAML_ISSUER value for audience validation
# Only set this if your IdP uses a different audience value than the Entity ID
# SAML_AUDIENCE=custom-audience-value

# ===== SP Certificates (Optional but Recommended) =====
# Generate certificates with: npm run generate-cert
# These certificates enable:
#   1. Signing SAML requests to the IdP
#   2. Decrypting encrypted SAML assertions from the IdP
# If not provided, defaults to: certs/sp-cert.pem and certs/sp-key.pem
# SAML_SP_CERT_PATH=certs/sp-cert.pem
# SAML_SP_KEY_PATH=certs/sp-key.pem

# ===== Session Configuration =====
# Session Secret (REQUIRED - Change this in production!)
SESSION_SECRET=your-secret-key-change-in-production
