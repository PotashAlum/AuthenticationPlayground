@using AuthService.Helpers
@{
    ViewBag.Title = "Home";
}

<div class="text-center mb-4">
    <h1 class="display-4">Auth Service</h1>
    <p class="lead">SAML 2.0 & OpenID Connect Authentication</p>
    <p class="text-muted small">SAML: .NET Framework 4.8 & .NET 8.0 | OIDC: .NET Framework 4.8 only</p>
    <hr class="my-4">
</div>

@if (Request.IsAuthenticated)
{
    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">✅ Authenticated Successfully!</h4>
        <p>You are logged in as: <strong>@User.Identity.Name</strong></p>
        <hr>
        <h5>User Claims:</h5>
        <div class="table-responsive">
            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th style="width: 40%">Claim Type</th>
                        <th style="width: 60%">Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in System.Security.Claims.ClaimsPrincipal.Current.Claims)
                    {
                        <tr>
                            <td><code>@claim.Type</code></td>
                            <td>@claim.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <a href="@Url.Action("Logout", "Auth")" class="btn btn-danger mt-3">Logout</a>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">Not Authenticated</h4>
        <p>You are not currently logged in. Choose your authentication method:</p>
        <div class="mt-3">
            <a href="@Url.Action("Login", "Auth")" class="btn btn-primary btn-lg me-2 mb-2">
                Login with SAML 2.0
            </a>
            <a href="@Url.Action("Login", "Oidc")" class="btn btn-success btn-lg mb-2">
                Login with OpenID Connect
            </a>
        </div>
        <p class="text-muted small mt-2">
            <strong>Note:</strong> SAML works on both .NET Framework & .NET 8.0. OIDC requires .NET Framework 4.8.
        </p>
    </div>
}

<div class="mt-5">
    <h3>SAML Endpoints</h3>
    <p class="text-muted">Configure these endpoints in your Identity Provider (Azure Entra ID):</p>
    <ul class="list-group">
        <li class="list-group-item">
            <strong>Metadata URL:</strong>
            <a href="@Url.Action("Index", "Saml2", null, Request.Url.Scheme)" target="_blank">
                @Url.Action("Index", "Saml2", null, Request.Url.Scheme)
            </a>
        </li>
        <li class="list-group-item">
            <strong>Entity ID:</strong> <code>dotnet-framework-saml-sp</code>
        </li>
        <li class="list-group-item">
            <strong>Assertion Consumer Service (ACS):</strong>
            <code>@Url.Action("Acs", "Saml2", null, Request.Url.Scheme)</code>
        </li>
        <li class="list-group-item">
            <strong>Sign On URL:</strong>
            <code>@Url.Action("Login", "Auth", null, Request.Url.Scheme)</code>
        </li>
        <li class="list-group-item">
            <strong>Logout URL:</strong>
            <code>@Url.Action("Logout", "Auth", null, Request.Url.Scheme)</code>
        </li>
    </ul>
</div>

<div class="mt-5">
    <h3>Configuration</h3>
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Identity Provider</h5>
            <p class="card-text">
                This Service Provider is configured to authenticate with Azure Entra ID using the metadata URL specified in <code>Web.config</code>.
            </p>
            <p class="card-text">
                <strong>Tenant ID:</strong> <code>@ConfigHelper.AzureTenantId</code><br>
                <strong>App ID:</strong> <code>392e0c42-2ef3-45d6-8561-4eb70f3e187a</code>
            </p>
        </div>
    </div>
</div>

<!-- Extension Session Display (hidden by default) -->
<div id="extensionSessionDisplay" class="alert alert-success" role="alert" style="display: none;">
    <h4 class="alert-heading">✅ Active Session from Extension</h4>
    <p>You have an active session from the browser extension:</p>
    <div id="extensionSessionInfo"></div>
    <button id="clearExtensionSession" class="btn btn-warning mt-3">Clear Extension Session</button>
</div>

<script>
    const EXTENSION_ID = '@ConfigHelper.ExtensionId';

    // Check for existing session in extension on page load
    async function checkExtensionSession() {
        // Don't check extension if already authenticated server-side
        const isAuthenticated = @(Request.IsAuthenticated ? "true" : "false");
        if (isAuthenticated) {
            console.log('Already authenticated server-side, skipping extension check');
            return;
        }

        if (typeof chrome === 'undefined' || !chrome.runtime) {
            console.log('Extension runtime not available');
            return;
        }

        try {
            chrome.runtime.sendMessage(EXTENSION_ID, {
                action: 'getSession'
            }, (response) => {
                if (chrome.runtime.lastError) {
                    console.log('Extension not available:', chrome.runtime.lastError.message);
                    return;
                }

                if (response && response.session) {
                    console.log('Found active session in extension:', response.session);
                    displayExtensionSession(response.session);
                } else {
                    console.log('No active session in extension');
                }
            });
        } catch (error) {
            console.error('Error checking extension session:', error);
        }
    }

    async function displayExtensionSession(session) {
        // First, try to sign in with the extension session
        try {
            console.log('Calling ExtensionLogin with:', session.user);
            const response = await fetch('@Url.Action("ExtensionLogin", "Auth")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    userName: session.user.name,
                    userEmail: session.user.email
                })
            });

            console.log('Response status:', response.status);
            const result = await response.json();
            console.log('Response result:', result);

            if (result.success) {
                // Successfully signed in, reload the page to show authenticated state
                console.log('Successfully signed in with extension session - reloading page');
                window.location.reload();
                return;
            } else {
                console.error('Failed to sign in with extension session:', result.error);
                alert('Failed to auto-sign in: ' + result.error);
            }
        } catch (error) {
            console.error('Error signing in with extension session:', error);
            alert('Error during auto-sign in: ' + error.message);
        }

        // If sign-in failed, just display the session info
        const displayDiv = document.getElementById('extensionSessionDisplay');
        const infoDiv = document.getElementById('extensionSessionInfo');

        const sessionDate = new Date(session.authenticatedAt);
        infoDiv.innerHTML = `
            <p><strong>User:</strong> ${session.user.name}</p>
            <p><strong>Email:</strong> ${session.user.email}</p>
            <p><strong>Authenticated:</strong> ${sessionDate.toLocaleString()}</p>
            <p class="text-warning"><small>Note: Could not auto-sign in. Click a login button to authenticate.</small></p>
        `;

        displayDiv.style.display = 'block';

        // Hide the login buttons if session exists
        const loginAlert = document.querySelector('.alert-info');
        if (loginAlert) {
            loginAlert.style.display = 'none';
        }
    }

    // Clear extension session button handler
    document.getElementById('clearExtensionSession')?.addEventListener('click', function() {
        if (typeof chrome !== 'undefined' && chrome.runtime) {
            chrome.runtime.sendMessage(EXTENSION_ID, {
                action: 'logout'
            }, (response) => {
                if (!chrome.runtime.lastError) {
                    document.getElementById('extensionSessionDisplay').style.display = 'none';
                    const loginAlert = document.querySelector('.alert-info');
                    if (loginAlert) {
                        loginAlert.style.display = 'block';
                    }
                    console.log('Extension session cleared');
                }
            });
        }
    });

    // Check for extension session when page loads
    window.addEventListener('load', checkExtensionSession);
</script>

@if (Request.IsAuthenticated)
{
    <script>
        // Auto-save session to extension when user is authenticated
        // Extract user info from the page
        const userIdentity = '@User.Identity.Name';
        const claims = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            System.Security.Claims.ClaimsPrincipal.Current.Claims.Select(c => new { Type = c.Type, Value = c.Value })
        ));

        const userName = claims.find(c => c.Type.includes('displayname') || c.Type.includes('givenname'))?.Value ||
                        claims.find(c => c.Type.includes('name'))?.Value ||
                        userIdentity;
        const userEmail = claims.find(c => c.Type.includes('emailaddress') || c.Type.includes('upn'))?.Value || '';

        // Try to save to extension
        if (typeof chrome !== 'undefined' && chrome.runtime) {
            chrome.runtime.sendMessage(EXTENSION_ID, {
                action: 'saveSession',
                session: {
                    user: {
                        name: userName,
                        email: userEmail
                    },
                    authenticatedAt: Date.now()
                }
            }, (response) => {
                if (chrome.runtime.lastError) {
                    console.log('Extension not available:', chrome.runtime.lastError.message);
                } else if (response && response.success) {
                    console.log('Session saved to extension successfully!');
                } else {
                    console.log('Failed to save to extension');
                }
            });
        }
    </script>
}
