<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SAML Service Provider (.NET Framework)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding-top: 20px;
            padding-bottom: 20px;
        }
        .navbar {
            margin-bottom: 20px;
        }
        code {
            color: #c7254e;
            background-color: #f9f2f4;
            padding: 2px 4px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">SAML SP (.NET Framework)</a>
            <div class="navbar-nav ms-auto">
                @if (Request.IsAuthenticated)
                {
                    <span class="navbar-text text-white me-3">
                        @User.Identity.Name
                    </span>
                    <a href="@Url.Action("Logout", "Auth")" class="btn btn-outline-light">Logout</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Auth")" class="btn btn-outline-light">Login</a>
                }
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <footer class="container mt-5 pt-3 border-top text-center text-muted">
        <p>&copy; @DateTime.Now.Year - SAML Service Provider (.NET Framework 4.8)</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
